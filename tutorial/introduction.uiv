[version]
format: 0.1.1
notes: "Example usage of .uiv without .ut for introduction.py"

# ---------------------------------------------------------

[circuit]
# The current represented as a complex number
current_phasor: 10+1j (A)
current_range: [0, 3] (A)
voltage_range: [5, 12, 24] k(kg*m^2*s^-3*A^-1)      # Voltage
magnet_grade: [0.836, 1.10] M(A/m), (kg*s^-2*A^-1)  # H, B fields

# ---------------------------------------------------------

[coil]
axial_length: 50 m(m)
outer_radius: 17.5 m(m)
inner_radius: 6.25 m(m)
wire_diameter: 1.25 m(m)
fill_factor: 0.7  (∅)

# ---------------------------------------------------------

[stator]
num_poles: 10

[stator.pole]
axial_length: 10 m(m)
outer_radius: 10 m(m)

temperature_conductivity: [
  [273.0, 0.697],
  [293.0, 0.667],
  [323.0, 0.663],
  [373.0, 0.656],
  [423.0, 0.649],
  [473.0, 0.643]
] (K), M(kg^-1*m^-3*s^3*A^2)    # kelvin : siemens

